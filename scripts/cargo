#!/usr/bin/env bash
# Run cargo for this repo inside a throwaway container, never on the host.
#   scripts/cargo <subcommand> [args…]   e.g. scripts/cargo build --release, scripts/cargo test
#   scripts/cargo --down                 remove what this script made: the image and the crate cache
#
# The image cu-rust:1.99.1 is rust:1.99-alpine, pinned by digest (rustc 1.99.1, musl host, so
# binaries are static), plus rustfmt and clippy. It is made once, with network, by
# `docker commit` of a one-off container: no build cache is left behind.
#
# Every run is a new container (--init, so Ctrl-C stops cargo) with:
#   - your uid, no capabilities, no new privileges, a read-only root, /tmp a tmpfs;
#   - the source read-only at /src (.git always read-only);
#   - this checkout's target/ at /target, so a build lands in ./target (git ignores it);
#   - CARGO_HOME a fresh tmpfs: a config.toml, wrapper or binary that a build script, proc
#     macro or test writes there is gone in the next run. Only the crate downloads persist, in
#     the volume cu-cargo-registry-<uid> at CARGO_HOME/registry;
#   - no network, cargo offline.
# Exceptions:
#   - fetch, generate-lockfile, update: network on, in a copy of the source inside the
#     container; only the resulting Cargo.lock comes back (check it with git diff);
#   - fmt without --check: the source writable (.git still read-only), no network.
# Cargo's own options go after the subcommand (scripts/cargo build -v): a leading option or
# +toolchain is refused, because the subcommand picks the mode.
set -euo pipefail
BASE=rust@sha256:44819b27be4c97b0e4d7203bd2e02c4820f97700211b6a37fb4c246a2de59383 # rust:1.99-alpine
TOOLCHAIN=1.99.1-x86_64-unknown-linux-musl
IMG=cu-rust:1.99.1
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
die() { echo "scripts/cargo: $*" >&2; exit 2; }
command -v docker > /dev/null || die "docker not found"
uid=$(id -u) gid=$(id -g)
[ "$uid" != 0 ] || die "refusing to run as root"
case $REPO in *,*) die "the repo path must not contain a comma (docker --mount): $REPO" ;; esac
VOL=cu-cargo-registry-$uid
LOCKDIR=${XDG_RUNTIME_DIR:-$HOME/.cache}
mkdir -p "$LOCKDIR"

# Undo a setup step that stopped part way (an error, Ctrl-C).
setup='' pulled='' newvol=''
cleanup() {
	[ -z "$setup" ] || docker rm -f "$setup" > /dev/null 2>&1 || true
	[ -z "$newvol" ] || docker volume rm -f "$newvol" > /dev/null 2>&1 || true
	[ -z "$pulled" ] || docker image rm "$BASE" > /dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

# One setup at a time for this user (a second run waits instead of breaking the first).
exec 9> "$LOCKDIR/cu-rust.lock"
flock 9

if [ "${1:-}" = --down ]; then
	docker volume rm -f "$VOL" > /dev/null
	docker image rm -f "$IMG" > /dev/null 2>&1 || true
	echo "scripts/cargo: removed $IMG and the volume $VOL (./target is left alone)"
	exit 0
fi
[ $# -gt 0 ] || die "usage: scripts/cargo <subcommand> [args…] | --down"
case $1 in
-* | +*) die "put cargo's options after the subcommand: scripts/cargo <subcommand> [options]" ;;
esac

if ! docker image inspect "$IMG" > /dev/null 2>&1; then
	docker image inspect "$BASE" > /dev/null 2>&1 || pulled=1
	setup=cu-rust-setup-$$
	echo "scripts/cargo: making $IMG (once; needs network)" >&2
	docker run --name "$setup" "$BASE" rustup component add --toolchain "$TOOLCHAIN" rustfmt clippy >&2
	docker commit --change 'CMD ["sh"]' "$setup" "$IMG" > /dev/null
	docker rm "$setup" > /dev/null
	setup=''
	# The base was pulled only for this: drop its name (the new image keeps the layers).
	if [ -n "$pulled" ]; then docker image rm "$BASE" > /dev/null; pulled=''; fi
fi
if ! docker volume inspect "$VOL" > /dev/null 2>&1; then
	newvol=$VOL
	docker volume create "$VOL" > /dev/null
	# A new volume is root's: hand it to the user (removed again if this does not finish).
	docker run --rm --network none --mount "type=volume,src=$VOL,dst=/v" "$IMG" chown "$uid:$gid" /v
	newvol=''
fi
exec 9>&-
trap - EXIT INT TERM HUP

mkdir -p "$REPO/target"
run=(docker run --rm --init --user "$uid:$gid"
	--cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp
	--tmpfs "/cargo:uid=$uid,gid=$gid,mode=0700"
	-e HOME=/tmp -e CARGO_HOME=/cargo -e CARGO_TARGET_DIR=/target
	--mount "type=volume,src=$VOL,dst=/cargo/registry"
	--mount "type=bind,src=$REPO/target,dst=/target")
[ -t 0 ] && [ -t 1 ] && [ -t 2 ] && run+=(-t)
src_ro=(--mount "type=bind,src=$REPO,dst=/src,readonly" -w /src)

case $1 in
fetch | generate-lockfile | update)
	# Network on: work on a copy, return only Cargo.lock.
	new=$(mktemp "$REPO/.Cargo.lock.XXXXXX")
	trap 'rm -f "$new"' EXIT
	# shellcheck disable=SC2016 # expanded by the container's shell
	"${run[@]}" --network bridge -e CARGO_NET_OFFLINE=false "${src_ro[@]}" "$IMG" sh -euc '
		mkdir /tmp/w
		tar -C /src --exclude=./target --exclude=./.git -cf - . | tar -C /tmp/w -xf -
		cd /tmp/w
		cargo "$@" >&2
		cat Cargo.lock' sh "$@" > "$new"
	[ -s "$new" ] || die "no Cargo.lock came back"
	chmod 0644 "$new"
	mv -f "$new" "$REPO/Cargo.lock"
	;;
fmt)
	if [[ " $* " == *" --check "* ]]; then
		exec "${run[@]}" --network none -e CARGO_NET_OFFLINE=true "${src_ro[@]}" "$IMG" cargo "$@"
	fi
	exec "${run[@]}" --network none -e CARGO_NET_OFFLINE=true \
		--mount "type=bind,src=$REPO,dst=/src" --mount "type=bind,src=$REPO/.git,dst=/src/.git,readonly" \
		-w /src "$IMG" cargo "$@"
	;;
*)
	exec "${run[@]}" --network none -e CARGO_NET_OFFLINE=true "${src_ro[@]}" "$IMG" cargo "$@"
	;;
esac
